{
  "name": "electron-angular-template",
  "version": "0.1.0",
  "description": "A modern Electron application template with Angular frontend and TypeScript support",
  "keywords": [
    "electron",
    "angular",
    "typescript",
    "template",
    "boilerplate",
    "starter",
    "monorepo",
    "npm-workspaces",
    "desktop-app",
    "cross-platform",
    "zoneless",
    "standalone-components"
  ],
  "homepage": "https://github.com/cchandurkar/electron-angular-template#readme",
  "bugs": {
    "url": "https://github.com/cchandurkar/electron-angular-template/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cchandurkar/electron-angular-template.git"
  },
  "license": "MIT",
  "author": {
    "name": "Chaitanya Chandurkar",
    "email": "cchandurkar@gmail.com"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">= 22.12.0",
    "npm": ">= 10.0.0"
  },
  "workspaces": [
    "packages/main",
    "packages/renderer",
    "packages/shared"
  ],
  "scripts": {
    "start": "npm run dev",
    "dev": "npm run shared:build && npm-run-all -p shared:serve app:serve electron:serve",
    "build": "npm run clean && npm run shared:build && npm run app:build && npm run electron:build",
    "package": "npm run clean && npm run shared:build && npm run app:build && npm run electron:package",
    "shared:serve": "(cd packages/shared && npm run serve)",
    "shared:build": "(cd packages/shared && npm run build)",
    "app:serve": "(cd packages/renderer && npm start)",
    "app:build": "(cd packages/renderer && npm run build)",
    "electron:serve": "(cd packages/main && npm run serve)",
    "electron:start": "(cd packages/main && npm start)",
    "electron:build": "(cd packages/main && npm run build)",
    "electron:package": "(cd packages/main && npm run package)",
    "postinstall": "electron-builder install-app-deps",
    "clean": "rimraf dist && rimraf build && rimraf --glob packages/**/dist",
    "lint": "npm run shared:build && npm run lint --ws",
    "lint:main": "(cd packages/main && npm run lint)",
    "lint:renderer": "(cd packages/renderer && npm run lint)",
    "lint:shared": "(cd packages/shared && npm run lint)",
    "lint:fix": "npm run shared:build && npm-run-all -p lint:*:fix",
    "lint:main:fix": "(cd packages/main && npm run lint:fix)",
    "lint:renderer:fix": "(cd packages/renderer && npm run lint:fix)",
    "lint:shared:fix": "(cd packages/shared && npm run lint:fix)",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run test:e2e",
    "test": "npm-run-all -p test:main test:renderer test:shared",
    "test:main": "(cd packages/main && npm run test)",
    "test:renderer": "(cd packages/renderer && npm run test -- --watch=false --browsers=ChromeHeadless)",
    "test:shared": "(cd packages/shared && npm run test)",
    "pretest:e2e": "npm run shared:build && npm run app:build && npm run electron:build",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "typecheck": "npm run shared:build && npm-run-all -p typecheck:*",
    "typecheck:main": "(cd packages/main && npm run typecheck)",
    "typecheck:renderer": "(cd packages/renderer && npx ng build -c development)",
    "typecheck:shared": "(cd packages/shared && tsc --noEmit)",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json --noEmit",
    "dev:debug": "npm run start -- --remote-debugging-port=9222",
    "rebrand": "node scripts/rebrand.mjs",
    "deps:check": "npm-check-updates",
    "deps:update": "npm-check-updates -u && npm install"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-ts": "3.1.0",
    "@eslint/js": "9.33.0",
    "@inquirer/prompts": "8.7.2",
    "@playwright/test": "^1.55.0",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "concurrently": "^9.2.0",
    "cross-env": "10.0.0",
    "electron": "44.4.3",
    "electron-builder": "^26.15.5",
    "eslint": "^9.33.0",
    "eslint-plugin-n": "17.21.3",
    "nodemon": "3.1.10",
    "npm-check-updates": "18.0.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.61.1",
    "wait-on": "^8.0.4"
  }
}
