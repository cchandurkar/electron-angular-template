{
  "name": "electron-angular-template",
  "productName": "Electron Angular Template",
  "version": "1.0.0",
  "description": "A template for building modern Electron apps with Angular",
  "main": "dist/main/index.js",
  "scripts": {
    "start": "npm-run-all -p app:serve electron:serve",
    "app:serve": "(cd src/renderer && npm start)",
    "app:build": "(cd src/renderer && npm run build)",
    "electron:start": "electron .",
    "electron:serve": "wait-on tcp:4200 && npm run electron:serve-tsc && electron . --serve",
    "electron:serve-tsc": "tsc -p tsconfig.json",
    "electron:serve-app": "wait-on dist/main/index.js && electron . --serve",
    "postinstall": "electron-rebuild && electron-builder install-app-deps && (cd src/renderer && npm install)",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "npm-run-all -p lint:electron lint:renderer",
    "lint:fix": "npm-run-all -p lint:electron:fix lint:renderer:fix",
    "lint:electron": "eslint --ext .ts,.js src/main src/preload",
    "lint:renderer": "(cd src/renderer && npm run lint)",
    "lint:electron:fix": "eslint --ext .ts,.js src/main src/preload --fix",
    "lint:renderer:fix": "(cd src/renderer && npm run lint:fix)",
    "gen:types": "tsc -p tsconfig.types.json"
  },
  "author": "Chaitanya Chandurkar",
  "license": "MIT",
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "electron": "^36.7.3",
    "electron-debug": "^4.1.0",
    "electron-log": "^5.1.7",
    "electron-reloader": "^1.2.3",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron/rebuild": "^3.6.0",
    "@types/electron": "^1.4.38",
    "@types/node": "^22.5.1",
    "@types/yargs": "^17.0.33",
    "electron-builder": "^24.13.3",
    "electron-reload": "^2.0.0-alpha.1",
    "eslint": "^9.29.0",
    "npm-run-all": "^4.1.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "wait-on": "^8.0.0"
  }
}
