{
  "name": "main",
  "productName": "Electron Angular Template",
  "version": "1.0.0",
  "description": "A template for building modern Electron apps with Angular",
  "main": "../../dist/main/index.js",
  "type": "module",
  "scripts": {
    "serve": "wait-on tcp:4200 && npm run electron:serve-tsc && electron . --serve",
    "start": "npm run electron:serve-tsc && electron .",
    "serve-tsc": "tsc -p tsconfig.json",
    "postinstall": "electron-rebuild && electron-builder install-app-deps",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint --ext .ts,.js",
    "lint:fix": "eslint --ext .ts,.js --fix"
  },
  "author": "Chaitanya Chandurkar",
  "license": "MIT",
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "bootstrap-icons": "1.13.1",
    "electron": "^36.7.3",
    "electron-debug": "^4.1.0",
    "electron-log": "^5.1.7",
    "electron-reloader": "^1.2.3",
    "winston": "3.17.0",
    "winston-daily-rotate-file": "5.0.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron/rebuild": "^3.6.0",
    "@types/electron": "^1.4.38",
    "@types/node": "^22.5.1",
    "@types/yargs": "^17.0.33",
    "chokidar": "4.0.3",
    "electron-builder": "26.0.12",
    "electron-reload": "^2.0.0-alpha.1",
    "eslint": "^9.29.0",
    "npm-run-all": "^4.1.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "5.8.3",
    "wait-on": "^8.0.0"
  },
  "engines": {
    "node": ">= 22.12.0 <= 24.0.0",
    "typescript": ">= 5.8.0 < 5.9.0"
  },
  "browserslist": [
    "chrome 136"
  ]
}
