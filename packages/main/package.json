{
  "name": "main",
  "productName": "Electron Angular Template",
  "version": "1.0.0",
  "description": "A template for building modern Electron apps with Angular",
  "main": "dist/main/index.js",
  "type": "module",
  "scripts": {
    "build": "npm run tsc:build && electron-builder --publish never",
    "serve": "wait-on tcp:4200 && electron-vite dev -- --serve",
    "start": "npm run tsc:build && electron .",
    "tsc": "tsc -p tsconfig.json",
    "tsc:build": "tsc -p tsconfig.json --outDir ./dist/main",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint --ext .ts,.js",
    "lint:fix": "eslint --ext .ts,.js --fix"
  },
  "author": "Chaitanya Chandurkar",
  "license": "MIT",
  "dependencies": {
    "@local/shared": "*",
    "electron-log": "^5.1.7",
    "electron-unhandled": "5.0.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@types/electron": "^1.4.38",
    "@types/node": "^22.5.1",
    "@types/yargs": "^17.0.33",
    "chokidar": "4.0.3",
    "electron": "36.7.3",
    "electron-builder": "26.0.12",
    "electron-debug": "^4.1.0",
    "electron-reload": "^2.0.0-alpha.1",
    "electron-reloader": "^1.2.3",
    "electron-vite": "4.0.0",
    "eslint": "^9.29.0",
    "npm-run-all": "^4.1.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "5.8.3",
    "wait-on": "^8.0.0"
  },
  "engines": {
    "node": ">= 22.12.0 <= 24.0.0",
    "typescript": ">= 5.8.0 < 5.9.0"
  },
  "browserslist": [
    "chrome 136"
  ]
}
