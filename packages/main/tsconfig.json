{
  "compilerOptions": {
    "outDir": "dist/main",
    "sourceMap": true,
    "moduleResolution": "node",
    "declaration": true,
    "declarationMap": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "module": "ES2022",
    "target": "ES2022",
    "types": ["node"],
    "lib": ["ES2022", "es2017", "es2016", "es2015", "dom"],
    "paths": {
      "@shared/*": ["../shared/src/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
