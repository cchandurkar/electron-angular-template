{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist/main",
    "strict": true,
    "sourceMap": true,
    "moduleResolution": "node",
    "declaration": true,
    "skipLibCheck": true,
    "declarationMap": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "composite": true,
    "esModuleInterop": true,
    "module": "ES2022",
    "target": "ES2022",
    "types": ["node"],
    "lib": ["ES2022", "es2017", "es2016", "es2015", "dom"],
    "paths": {
      "@local/shared/*": ["../shared/dist/*"]
    }
  },
  "include": ["./src/**/*.ts"]
}
