{
  "compilerOptions": {
    "outDir": "../../dist/main",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "module": "commonjs",
    "target": "es2015",
    "types": [
      "node"
    ],
    "lib": [
      "es2017",
      "es2016",
      "es2015",
      "dom"
    ],
    "paths": {
      "@shared/*": [
        "../shared/src/*"
      ]
    }
  },
  "files": [
    "src/index.ts",
    "src/preload/index.ts",
    "src/preload/index.d.ts"
  ],
}
