{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["./packages/shared/src/*"],
      "@main/*": ["./packages/main/src/*"],
      "@renderer/*": ["./packages/renderer/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "packages/*/dist", "packages/*/node_modules"]
}
