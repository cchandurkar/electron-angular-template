{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🔍 Debug Main Process",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/packages/main",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron",
      "runtimeArgs": ["--enable-logging", "--remote-debugging-port=9222", "."],
      "env": {
        "NODE_ENV": "development"
      },
      "console": "integratedTerminal",
      "restart": true
    },
    {
      "name": "🎨 Debug Renderer Process",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}/packages/renderer/src",
      "sourceMapPathOverrides": {
        "webpack:///./src/*": "${webRoot}/*"
      }
    },
    {
      "name": "🚀 Debug Full App",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["start"],
      "env": {
        "NODE_ENV": "development"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "🧪 Debug Tests (Renderer)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:9876/debug.html",
      "webRoot": "${workspaceFolder}/packages/renderer/src",
      "sourceMapPathOverrides": {
        "webpack:///./src/*": "${webRoot}/*"
      }
    }
  ],
  "compounds": [
    {
      "name": "🔥 Debug All Processes",
      "configurations": ["🔍 Debug Main Process", "🎨 Debug Renderer Process"],
      "stopAll": true
    }
  ]
}
